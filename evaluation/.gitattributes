# Preserve scientific results, figures and exact historical snapshots after moves.
histry/** -text
holding/** -text
vectoring/** -text
hourly/** -text
star/** -text
report/figures/** -text
requirements-screening.txt -text
# Active code and current navigation use LF; this does not include frozen source/.
code/*.py text eol=lf
holding/code/*.py text eol=lf
vectoring/code/*.py text eol=lf
hourly/code/*.py text eol=lf
README.md text eol=lf
report.md text eol=lf
report/*.md text eol=lf
# Matplotlib SVG paths contain intentional generated trailing spaces.
*.svg -whitespace
